# SMTP utilisé pour l'envoi des offres commerciales ABIX.
# Copier ce fichier vers .env sur le serveur et remplacer les valeurs exemples.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=abix@tadjeddine-partners.com
EMAIL_HOST_PASSWORD=replace-with-the-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15

# Adresse visible par le destinataire.
ABIX_OFFER_FROM_EMAIL=abix@tadjeddine-partners.com
ABIX_OFFER_REPLY_TO=abix@tadjeddine-partners.com
